# Microsoft Graph API - Azure AD credentials
AZURE_CLIENT_ID=your_client_id_here
AZURE_CLIENT_SECRET=your_client_secret_here
AZURE_TENANT_ID=sophiaaurea.onmicrosoft.com

# OneDrive user whose drive holds the catalog files
ONEDRIVE_USER_EMAIL=hola@sophiaaurea.co

# Excel file name, and (optional) the OneDrive folder that holds it
EXCEL_FILE_NAME=TablaProductos_Sophia_Aurea.xlsx
EXCEL_FOLDER_PATH=/SOI/06-Financiero/movimientos financieros/datos/archivos gestión

# Folders for product photos (paths relative to the user's OneDrive root,
# comma-separated to read more than one)
PHOTOS_FOLDER=/SOI/01-Marca/fotografia/Fotografia productos julio 29 - 1 pdn,/SOI/01-Marca/fotografia/Fotografías productos agosto 5 - 2 pan/fotografias peso web

# Prefijo desde donde se sirven JS/CSS. Necesario porque este catalogo tambien
# se reenvia desde sophiaaurea.co/catalogo: sin el, pide sus assets al dominio
# del website de marca y da 404 ("Cargando catalogo..." infinito).
NEXT_PUBLIC_ASSET_PREFIX=https://catalogo.sophiaaurea.co
